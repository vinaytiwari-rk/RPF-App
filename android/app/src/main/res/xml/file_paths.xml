<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Allow sharing APK and downloaded files from public Downloads directory -->
    <external-path name="external_downloads" path="Download" />
    <external-path name="external_samahit" path="Download/SAMAHIT" />
    <!-- Allow sharing files from app's internal cache and files directories -->
    <cache-path name="internal_cache" path="." />
    <files-path name="internal_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-files-path name="external_files" path="." />
</paths>
