# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/vfpmlbpv/appapi.therpfoundation.org"
PassengerBaseURI "/"
PassengerNodejs "/home/vfpmlbpv/nodevenv/appapi.therpfoundation.org/22/bin/node"
PassengerAppType node
PassengerStartupFile server.cjs
PassengerMinInstances 1
PassengerMaxPoolSize 2
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Disable Imunify360 Web Shield Bot Protection for API routes
<IfModule mod_env.c>
  SetEnvIf Request_URI "^/api/" imunify360_disabled=1
  SetEnvIf Request_URI "^/api/health" imunify360_disabled=1
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Direct static PHP scripts to Apache PHP handler
  RewriteCond %{REQUEST_FILENAME} \.php$
  RewriteRule ^ - [L]
</IfModule>



