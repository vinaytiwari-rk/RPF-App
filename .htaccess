# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/vfpmlbpv/appapi.therpfoundation.org"
PassengerBaseURI "/"
PassengerNodejs "/home/vfpmlbpv/nodevenv/appapi.therpfoundation.org/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerMinInstances 1
PassengerMaxPoolSize 2
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Disable Imunify360 Web Shield Bot Protection for API routes
<IfModule mod_env.c>
  SetEnvIf Request_URI "^/api/" imunify360_disabled=1
  SetEnvIf Request_URI "^/api/health" imunify360_disabled=1
</IfModule>

# API CORS: the frontend uses bearer-token authorization, not cookie credentials.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH"
  Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Cache-Control, Pragma"
  Header always set Access-Control-Max-Age "86400"
  Header always set Vary "Origin"
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep PHP scripts on the PHP handler.
  RewriteCond %{REQUEST_FILENAME} \.php$
  RewriteRule ^ - [L]

  # Never allow uncompiled Vite/TypeScript source to be served in production.
  RewriteRule ^src/ - [F,L]

  # The deployment mirrors dist/assets into the document-root assets directory.
  # Stop rewrite processing so real JS/CSS/image files are served directly.
  RewriteRule ^assets/ - [L]
  RewriteRule ^version\.json$ - [L]

  # Do not re-enter the rewrite rules for generated deployment files.
  RewriteRule ^dist/ - [L]

  # Serve the compiled production SPA shell.
  RewriteRule ^$ dist/index.html [L]

  # API requests must stay with CloudLinux Passenger/Express.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/src/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !^/version\.json$
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^.+$ dist/index.html [L]
</IfModule>
