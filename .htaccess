# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/vfpmlbpv/appapi.therpfoundation.org"
PassengerBaseURI "/"
PassengerNodejs "/home/vfpmlbpv/nodevenv/appapi.therpfoundation.org/22/bin/node"
PassengerAppType node
PassengerStartupFile app.js
PassengerMinInstances 1
PassengerMaxPoolSize 2
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Disable Imunify360 Web Shield Bot Protection for API routes
<IfModule mod_env.c>
  SetEnvIf Request_URI "^/api/" imunify360_disabled=1
  SetEnvIf Request_URI "^/api/health" imunify360_disabled=1
</IfModule>

# API CORS: the frontend uses bearer-token authorization, not cookie credentials.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH"
  Header always set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Cache-Control, Pragma"
  Header always set Access-Control-Max-Age "86400"
  Header always set Vary "Origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep PHP scripts on the PHP handler.
  RewriteCond %{REQUEST_FILENAME} \.php$
  RewriteRule ^ - [L]

  # Never allow uncompiled Vite/TypeScript source to be served in production.
  RewriteRule ^src/ - [F,L]

  # IMPORTANT: stop per-directory rewrite processing after an internal dist/ rewrite.
  # Without this, /assets/*.js is rewritten to dist/assets/*.js and then processed
  # again by the SPA fallback, which returns index.html as text/html. Browsers then
  # reject the JavaScript/CSS because of the MIME type.
  RewriteRule ^dist/ - [END]

  # Serve the compiled production SPA shell and compiled assets from dist/.
  RewriteRule ^$ dist/index.html [END]
  RewriteRule ^assets/(.*)$ dist/assets/$1 [END]

  # SPA routes use the compiled production shell; API routes remain Passenger/Express.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/src/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule ^.+$ dist/index.html [END]
</IfModule>
