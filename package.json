{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cross-env GOMAXPROCS=1 RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=1 NODE_OPTIONS=\"--max-old-space-size=2048\" vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:express --external:dotenv --external:pg --external:multer --external:axios --external:cheerio --external:@google/genai --external:vite --sourcemap --outfile=dist/server.cjs && node -e \"require('fs').copyFileSync('dist/server.cjs', 'server.cjs')\"",
    "start": "node server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "browser:check": "node scripts/checkBrowserPolicy.cjs",
    "migrate": "node scripts/runMigrations.cjs"
  },
