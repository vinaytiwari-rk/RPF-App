{
  "name": "react-example",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/writeAppVersion.cjs && cross-env GOMAXPROCS=1 RAYON_NUM_THREADS=1 UV_THREADPOOL_SIZE=1 NODE_OPTIONS=\"--max-old-space-size=2048\" vite build && esbuild server.ts --bundle --platform=node --outfile=server.cjs",
    "start": "node server.cjs",
    "clean": "rm -rf dist server.js server.cjs",
    "lint": "tsc --noEmit",
    "browser:check": "node scripts/checkBrowserPolicy.cjs",
    "browser:smoke": "node scripts/browserSmokeCheck.cjs",
    "migrate": "node scripts/runMigrations.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@simplewebauthn/browser": "^13.3.2",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/vite": "^4.1.14",
    "axios": "^1.18.1",
    "basic-ftp": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "esbuild": "^0.25.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0"
  }
}
